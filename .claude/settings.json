{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(uv run lint-imports *)",
      "Bash(uv run arete *)",
      "Bash(uv sync *)",
      "Bash(docker compose *)",
      "Bash(orb start)",
      "Bash(git *)",
      "Bash(npm --prefix obsidian-plugin *)",
      "Bash(npx tsc *)",
      "Read"
    ],
    "deny": [
      "Bash(uv run arete sync *--prune*--yes*)",
      "Bash(uv run arete sync *--yes*--prune*)",
      "Bash(uv run arete sync *--prune*-y*)",
      "Bash(uv run arete sync *-y*--prune*)",
      "Bash(arete sync *--prune*--yes*)",
      "Bash(arete sync *--yes*--prune*)",
      "Bash(arete sync *--prune*-y*)",
      "Bash(arete sync *-y*--prune*)"
    ]
  },
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r \".tool_input.file_path // empty\" 2>/dev/null); case \"$FILE\" in */anki_data/*|*/addons21/arete_ankiconnect/*) echo \"Blocked: do not edit live Anki add-on install or Docker anki_data files\" >&2; exit 2;; esac; exit 0'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "astral@astral-sh": true
  }
}
