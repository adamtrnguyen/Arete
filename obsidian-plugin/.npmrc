; ts-jest 29.x declares a typescript peer of ">=4.3 <6", which conflicts with
; our typescript ^6.0.3. ts-jest works fine under TS 6 (it only transpiles for
; Jest and is not part of the shipped build), so allow the resolution. This
; matches what CI and release.yml already pass (`npm ci --legacy-peer-deps`) and
; keeps plain `npm install` / `just install` working locally.
legacy-peer-deps=true
