{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strict": false,
		"types": ["node"],
		"moduleResolution": "bundler",
		"ignoreDeprecations": "6.0",
		"importHelpers": true,
		"esModuleInterop": true,
		"lib": ["dom", "es2018"],
		"paths": {
			"@/*": ["./src/*"],
			"@domain/*": ["./src/domain/*"],
			"@application/*": ["./src/application/*"],
			"@infrastructure/*": ["./src/infrastructure/*"],
			"@presentation/*": ["./src/presentation/*"]
		}
	},
	"include": ["src/**/*.ts"]
}
