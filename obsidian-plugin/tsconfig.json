{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2022",
		"allowJs": true,
		"strict": true,
		"types": ["node"],
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"lib": ["dom", "es2022"],
		"paths": {
			"@/*": ["./src/*"],
			"@domain/*": ["./src/domain/*"],
			"@application/*": ["./src/application/*"],
			"@infrastructure/*": ["./src/infrastructure/*"],
			"@presentation/*": ["./src/presentation/*"]
		}
	},
	"include": ["src/**/*.ts"]
}
