		"@types/node": "^24.0.0",
		"builtin-modules": "^5.0.0",
		"dependency-cruiser": "^17.3.6",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
