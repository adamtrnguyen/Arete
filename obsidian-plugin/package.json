{
  "name": "arete",
  "version": "4.1.0",
  "description": "Sync Obsidian vault to Anki",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "fmt:check": "prettier --check .",
    "check:min-app-version": "node scripts/min-app-version.cjs",
    "lint:deps": "depcruise src --config .dependency-cruiser.js",
    "format": "prettier --write .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "Adam Nguyen",
  "license": "GPL-3.0",
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.7",
    "babel-plugin-jest-hoist": "^30.5.0",
    "builtin-modules": "^5.5.0",
    "dependency-cruiser": "^18.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "js-yaml": "^5.5.0",
    "obsidian": "1.14.4",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "3d-force-graph": "^1.80.2",
    "d3": "^7.9.2",
    "mustache": "^4.2.0"
  },
  "overrides": {
    "@codemirror/view": "6.43.15",
    "@codemirror/state": "6.7.6"
  }
}
